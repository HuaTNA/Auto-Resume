# Railway API service. Store real values in Railway, never in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes
AGENT_CALLBACK_SECRET=replace-with-an-independent-random-secret
AUTO_RESUME_SERVICE_TOKEN=replace-with-an-independent-random-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PRODUCTION=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://YOUR_FRONTEND.example
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=replace-with-an-independent-random-value
LOCAL_AUTOMATION_SCHEDULER=false
OUTPUT_DIR=/tmp/auto-resume-output
HEALTHCHECK_REQUIRE_POSTGRES=true
LOG_LEVEL=INFO
