# OpenClaw is an execution adapter, not the source of truth.
AUTO_RESUME_API_URL=https://YOUR_API.example
AUTO_RESUME_SERVICE_TOKEN=must-match-the-Railway-secret
AUTO_RESUME_WEBHOOK_SECRET=must-match-AGENT_CALLBACK_SECRET-on-Railway
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
OPENCLAW_ALLOWED_PROVIDERS=greenhouse,lever,generic
OPENCLAW_REQUIRE_QUEUED_RECEIPT=true
